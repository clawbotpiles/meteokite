# MeteoKite local configuration

# Weather providers
OPEN_METEO_BASE_URL=https://api.open-meteo.com
AEMET_BASE_URL=https://opendata.aemet.es
AEMET_API_KEY=replace-with-your-aemet-api-key

# App behavior
APP_ENV=dev
DEV_BYPASS_ENABLED=true

# Feature flags (phase control)
FF_SOCIAL_ENABLED=false
FF_TOURNAMENTS_ENABLED=false
FF_BACKEND_SYNC_ENABLED=false
